{
  "id": "com.example.hello-import",
  "name": "Hello Import (Example)",
  "version": "1.0.0",
  "apiVersion": 1,
  "author": "Mouvi Examples",
  "description": "Эталонный плагин: демонстрирует декларативный хук importValidation (распознавание конфигов по схеме/маркерам).",
  "permissions": [
    "ownStorage",
    "connectionState",
    "configsMetadata"
  ],
  "hooks": [
    "importValidation"
  ],
  "importRules": [
    {
      "id": "mouvi-example-uri",
      "label": "Mouvi Example",
      "uriSchemes": ["mouvi-example://"],
      "containsAny": ["[MouviExample]"]
    }
  ]
}
